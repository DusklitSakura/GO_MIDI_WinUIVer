<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GoMidi.Views.PlayerPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GoMidi.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GoMidi.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GoMidi.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>

    <Grid Padding="16,12,16,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" MinWidth="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ==================== 播放列表 ====================  -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid Padding="12" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource SectionLabel}" Text="播放列表" />

                <Grid Grid.Row="1" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        x:Name="PlaylistSelector"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.PlaylistNames, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedPlaylistIndex, Mode=TwoWay}" />

                    <Button
                        Grid.Column="1"
                        Click="OnNewPlaylist"
                        ToolTipService.ToolTip="新建播放列表">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Click="OnRenamePlaylist"
                        ToolTipService.ToolTip="重命名">
                        <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Click="OnDeletePlaylist"
                        ToolTipService.ToolTip="删除播放列表">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </Grid>

                <Grid Grid.Row="2" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ImportFilesCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                <TextBlock Text="导入 MIDI" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.RemoveSelectedCommand}"
                            ToolTipService.ToolTip="移除选中">
                            <FontIcon FontSize="14" Glyph="&#xE738;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.ClearListCommand}"
                            ToolTipService.ToolTip="清空列表">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>

                    <AutoSuggestBox
                        Grid.Row="1"
                        PlaceholderText="搜索文件名…"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Grid.Row="2">
                        <ListView
                            x:Name="FileList"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            DragItemsCompleted="OnFileDragCompleted"
                            DoubleTapped="OnFileDoubleTapped"
                            ItemsSource="{x:Bind ViewModel.VisibleFiles, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaylistItemViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE8D6;" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                Text="{x:Bind FileName}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Path}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Detail, Mode=OneWay}"
                                                Visibility="{x:Bind local:PlayerPage.VisibleIf(IsMissing), Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OnPlaySelectedItem" Text="播放">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnRemoveSelectedItem" Text="从列表移除">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE738;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Visibility="{x:Bind local:PlayerPage.ShowWhenEmpty(ViewModel.VisibleFiles.Count), Mode=OneWay}">
                            <FontIcon
                                FontSize="28"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE8D6;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="还没有曲目" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="点击「导入 MIDI」或拖入 .mid 文件"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="3" Spacing="8">
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CyclePlayModeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                            <TextBlock Text="{x:Bind ViewModel.PlayModeName, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="双击播放 · 拖拽调整顺序 · 右键更多操作"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ==================== 演奏区 ====================  -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="16,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock
                            MaxLines="1"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CurrentDetail, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <Border
                            Padding="8,3"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="10">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.TransposeHint, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Right"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="F12 全局播放 / 暂停" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="8">
                <Grid>
                    <controls:PianoRoll x:Name="Roll" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="加载曲目后在此显示钢琴卷帘"
                        Visibility="{x:Bind local:PlayerPage.HideWhen(ViewModel.HasSong), Mode=OneWay}" />
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="16,12">
                <StackPanel Spacing="10">
                    <controls:AbLoopBar x:Name="SeekBar" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="右键设置 A/B 循环点：第一次设 A，第二次设 B 并开始循环，第三次清除" />

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                Command="{x:Bind ViewModel.PreviousCommand}"
                                ToolTipService.ToolTip="上一曲">
                                <FontIcon FontSize="16" Glyph="&#xE892;" />
                            </Button>

                            <Button
                                MinWidth="96"
                                Command="{x:Bind ViewModel.PlayPauseCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="播放 / 暂停 (F12)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="{x:Bind local:PlayerPage.PlayGlyph(ViewModel.IsPlaying), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind local:PlayerPage.PlayLabel(ViewModel.IsPlaying), Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <Button
                                Command="{x:Bind ViewModel.StopCommand}"
                                ToolTipService.ToolTip="停止">
                                <FontIcon FontSize="16" Glyph="&#xE71A;" />
                            </Button>

                            <Button
                                Command="{x:Bind ViewModel.NextCommand}"
                                ToolTipService.ToolTip="下一曲">
                                <FontIcon FontSize="16" Glyph="&#xE893;" />
                            </Button>

                            <Button
                                Command="{x:Bind ViewModel.ClearLoopPointsCommand}"
                                ToolTipService.ToolTip="清除 A/B 循环点">
                                <FontIcon FontSize="16" Glyph="&#xE894;" />
                            </Button>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="16">
                            <ToggleSwitch
                                MinWidth="0"
                                Header="和弦分解"
                                IsOn="{x:Bind ViewModel.DecomposeChords, Mode=TwoWay}"
                                OffContent="关"
                                OnContent="开"
                                ToolTipService.ToolTip="把同时按下的和弦拆成快速连续的单音，适配每次只识别一个按键的游戏" />

                            <NumberBox
                                Width="150"
                                Header="倍速"
                                LargeChange="0.5"
                                Maximum="100"
                                Minimum="0.1"
                                SmallChange="0.1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
